# Copy to .env.local and fill in real values for local development.
# In production these must be set in Vercel → Project Settings → Environment Variables.

# Resend API key — create one at https://resend.com/api-keys
RESEND_API_KEY=

# Address that should receive contact form submissions
CONTACT_TO=ariasgunnar@gmail.com

# Verified sender. During development you can use:
#   "Portfolio <onboarding@resend.dev>"
# In production verify a domain on Resend and use, e.g.:
#   "Gunnar <contact@gunnarwrld.com>"
CONTACT_FROM="Portfolio <onboarding@resend.dev>"
